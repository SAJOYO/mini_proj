# 이 파일을 `.env`로 복사해서 값을 채우세요. `.env`는 커밋되지 않습니다
# (루트 .gitignore의 `.env` / `.env.*` 규칙이 server/ 아래에도 그대로 적용됩니다).
#
# 이 서버는 ComfyUI와 같은 성격입니다 — 팀 노트북에서 `npm run dev`로 띄우고,
# 앱은 루트 `.env`의 EXPO_PUBLIC_MEMORY_URL로 여기(사설 IP)에 접속합니다.
# 여기 적는 키는 클라이언트 번들에 들어가지 않으므로 진짜 비밀로 취급하세요.

# 서버가 열리는 포트.
PORT=4000

# ── 요약 전용 LLM ──────────────────────────────────────
# 대화가 길어지면 오래된 턴을 압축할 때만 씁니다. 비워두면 요약을 건너뛰고
# 원문 턴을 계속 쌓기만 합니다 (기능이 죽지 않습니다 — 그냥 롱텀 압축이 안 될 뿐).
# 루트 .env의 EXPO_PUBLIC_CHAT_* 와 같은 값을 넣어도 됩니다.
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=
