# 페르소나 실험용 설정. 이 폴더의 persona:* 스크립트만 읽습니다.
#
# .env.persona 로 복사해서 쓰세요. .env 를 먼저 읽고 이 파일이 덮어씁니다.
# 그래서 팀 공용 .env 는 손대지 않고 여기서만 이것저것 바꿔볼 수 있습니다.
#
#   .env          팀 공용. LLM_* — 여기는 건드리지 마세요.
#   .env.persona  실험용. 아래 값으로 위를 덮어씁니다.
#
# 앱 코드는 이 파일을 읽지 않습니다. 스크립트 전용입니다.

# ── 판정용 (사진 → 품종 혼합) ─────────────────────────────
# 이미지 이해만 되면 되는 일이라 작은 비전 모델로 충분합니다.
# 실측: Qwen3-VL-8B 이 사진 3장 전부 1회 시도로 3품종을 뽑았습니다.
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
# json_schema  스키마까지 서버가 강제
# json_object  유효한 JSON까지만 강제. 스키마는 프롬프트로 전달
# prompt       서버가 강제하지 않음. 오픈 모델은 대개 이쪽
VISION_STRUCTURED_OUTPUT=

# ── 대화용 (성격 연기) ───────────────────────────────────
# 말버릇·말수·억제 지시를 동시에 지켜야 하는 일입니다.
# 실측: Qwen3-VL-8B 은 "짧게 답한다"와 "마음을 드러내지 않는다"를 둘 다
# 무시했고, gemini-3.1-flash-lite 는 같은 프롬프트로 전부 지켰습니다.
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=

# 비워두면 .env 의 LLM_* 로 떨어집니다.
# 한쪽만 채워도 되고, 둘 다 비우고 LLM_* 만 써도 됩니다.

# ── 앱 화면(/chat-preview)용 ────────────────────────────
# 위 값들은 스크립트 전용입니다. 앱은 이 파일을 읽지 않습니다.
#
# Expo는 EXPO_PUBLIC_ 접두사가 붙은 것만, 그리고 .env 또는 .env.local 에서만
# 읽습니다. 그래서 앱에서 대화를 확인하려면 아래 이름으로 .env.local 에
# 따로 넣어야 합니다.
#
#   .env.local  (gitignore 됨)
#     EXPO_PUBLIC_CHAT_API_KEY=
#     EXPO_PUBLIC_CHAT_MODEL=
#     EXPO_PUBLIC_CHAT_BASE_URL=
#
# ⚠️ EXPO_PUBLIC_ 값은 JS 번들에 문자열로 박힙니다. 앱을 열어보면 키가 보입니다.
# README의 API 키 섹션 B안(발표용으로만 쓰고 끝나면 폐기) 조건에서만 쓰세요.
# 프록시를 두는 A안으로 가면 BASE_URL만 프록시 주소로 바꾸고 키는 비웁니다.

# ── baseUrl 예시 ────────────────────────────────────────
#   Gemini (OpenAI 호환)   https://generativelanguage.googleapis.com/v1beta/openai
#   Hugging Face Router   https://router.huggingface.co/v1
#
# HF Router는 모델명에 provider를 붙여야 계정 설정 없이 호출됩니다.
#   Qwen/Qwen3-VL-8B-Instruct:featherless-ai
# Gemini 키는 aistudio.google.com/app/apikey 에서 발급합니다.
