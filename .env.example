# 이 파일을 `.env` 로 복사해서 값을 채우세요. `.env` 는 커밋되지 않습니다.
#
# 앱과 스크립트가 이 파일 하나를 같이 씁니다.
#   앱      src/lib/llm/config.ts
#   스크립트 scripts/llm-env.ts  (npm run persona:infer / persona:chat)
#
# ─────────────────────────────────────────────────────────────
# ⚠️ 키가 앱 번들에 그대로 박힙니다
# ─────────────────────────────────────────────────────────────
# `EXPO_PUBLIC_` 접두사가 붙은 값은 빌드할 때 소스에 리터럴로 치환됩니다.
# 앱을 설치한 사람이 번들을 열어보면 키가 보입니다. gitignore 는 깃허브에
# 안 올라가게 하는 것일 뿐, 앱 안에서는 노출됩니다.
#
# 그래서 README 「API 키」 섹션의 **B안** 조건에서만 쓰세요.
#   - 키를 절대 커밋하지 않기
#   - 발표가 끝나면 키 폐기
#   - 앱을 외부에 배포하지 않기
#
# 프록시를 두는 A안으로 옮길 때는 BASE_URL 을 프록시 주소로 바꾸고 키를
# 비우면 됩니다. 코드는 안 고쳐도 됩니다.
#
# 접두사가 필요한 이유와 왜 이름을 손으로 나열하는지는
# src/lib/llm/config.ts 맨 위 주석에 적어뒀습니다.

# ── 판정용 (사진 → 품종 혼합) ─────────────────────────────
# 이미지 이해만 되면 되는 일이라 작은 비전 모델로 충분합니다.
#
# 지금 쓰는 것: gemini-3.6-flash
# 실측 기록: Qwen3-VL-8B 도 사진 3장 전부 1회 시도로 3품종을 뽑았습니다.
#            판정만 놓고 보면 오픈 모델로도 됩니다 — 대화용 키와 같은 곳에서
#            받아 쓰려고 Gemini 로 맞췄습니다.
EXPO_PUBLIC_VISION_API_KEY=
EXPO_PUBLIC_VISION_MODEL=
EXPO_PUBLIC_VISION_BASE_URL=

# 이 서버가 출력 형식을 어디까지 강제해주는지. 비워두면 json_schema
#   json_schema  스키마까지 서버가 강제 (OpenAI, 일부 HF Provider)
#   json_object  유효한 JSON까지만 강제. 스키마는 프롬프트로 전달
#   prompt       서버가 강제하지 않음. 직접 띄운 오픈 모델에서 스키마가 안 먹을 때
# 확실치 않으면 prompt 로 시작해서 되는 걸 확인한 뒤 올리세요.
EXPO_PUBLIC_VISION_STRUCTURED_OUTPUT=

# ── 대화용 (성격 연기) ───────────────────────────────────
# 말버릇·말수·억제 지시를 동시에 지켜야 하는 일입니다.
#
# 지금 쓰는 것: gemini-3.1-flash-lite
# 실측 기록: Qwen3-VL-8B 은 "짧게 답한다"와 "마음을 드러내지 않는다"를 둘 다
#            무시했고, gemini-3.1-flash-lite 는 같은 프롬프트로 전부 지켰습니다.
#            판정과 달리 여기서는 모델을 바꾸면 성격 연기가 바로 무너집니다.
EXPO_PUBLIC_CHAT_API_KEY=
EXPO_PUBLIC_CHAT_MODEL=
EXPO_PUBLIC_CHAT_BASE_URL=

# ── BASE_URL 예시 ───────────────────────────────────────
#   OpenAI                 https://api.openai.com/v1
#   Gemini (OpenAI 호환)    https://generativelanguage.googleapis.com/v1beta/openai
#   Hugging Face Router    https://router.huggingface.co/v1
#   HF Inference Endpoint  https://<배포이름>.endpoints.huggingface.cloud/v1
#   vLLM / TGI             http://localhost:8000/v1
#   Ollama                 http://localhost:11434/v1
#   LM Studio              http://localhost:1234/v1
#
# HF Router 는 모델명에 provider 를 붙여야 계정 설정 없이 호출됩니다.
#   Qwen/Qwen3-VL-8B-Instruct:featherless-ai
# Gemini 키는 aistudio.google.com/app/apikey 에서 발급합니다.

# ── 사진 생성 (ComfyUI) ──────────────────────────────────
# 게임의 「사진 만들기」가 여기로 붙습니다. 위 LLM 키들과 달리 **키가
# 없습니다** — 팀원 노트북에서 도는 서버에 직접 붙기 때문입니다.
#
# 주소는 그 노트북에서 `ipconfig`(윈도우) / `ifconfig`(맥)로 확인한
# 192.168.x.x 형태의 사설 IP입니다. **와이파이가 바뀌면 IP도 바뀝니다.**
#
# 서버 쪽에서는 이렇게 띄워야 다른 기기가 붙을 수 있습니다.
#   python main.py --listen 0.0.0.0 --enable-cors-header "*"
# (--enable-cors-header 없이 `npm run web`으로 열면 브라우저가 전부 막습니다)
#
# 잘 붙는지 확인: 브라우저에서 아래 주소 + /system_stats 를 열어 JSON이 나오면 성공
EXPO_PUBLIC_COMFY_URL=http://192.168.0.93:8188
# 예시 : http://(ip주소):8188

# ── 시연 도구 ────────────────────────────────────────────
# 게임 화면 아래쪽의 「개발용 시연 도구」(단계 건너뛰기, 시간 앞당기기 등)를
# 보여줄지. 성장과 엔딩을 실제로 기다리지 않고 확인할 때 씁니다
# (청년기 180 EXP, 노년기는 함께한 지 7일).
#
# 비워두면 안 보입니다 — 개발 서버로 띄워도 마찬가지입니다. 실제 사용자가 볼
# 화면을 그대로 확인하려고 기본을 꺼둔 것입니다. 필요한 사람만 켜세요.
#
# ⚠️ 발표용 APK 에는 이 파일이 안 먹습니다. `.env` 는 gitignore 대상이라
# EAS 빌드로 업로드되지 않습니다. APK 는 eas.json 의 `demo` 프로필로 만드세요.
#   eas build -p android --profile demo
EXPO_PUBLIC_DEMO_TOOLS=
# 예시 : 1

# ── 대화 저장 (server/) ──────────────────────────────────
# 채팅 대화를 기억하게 해주는 서버입니다. ComfyUI와 같은 방식 — 키가 없고,
# 팀원 노트북에서 도는 서버(server/)에 직접 붙습니다. 자세한 실행법은
# 루트 README 의 「대화 저장 서버」 섹션 참고.
#
# 비워두면 대화 저장/복원 없이 지금까지와 같은 방식으로(메모리에만) 동작합니다 —
# 필수 설정이 아닙니다.
EXPO_PUBLIC_MEMORY_URL=
# 예시 : http://(ip주소):4000
